{% extends "_base.html.j2" %}

{% block main %}
<article id="game-details">
    <header class="game-header">
        <h1>Spiel: {{ game.title }}</h1>
        <a role="button" class="primary login-button" href="#{{ player_login_form.form_id }}">Login</a>
    </header>
    <main>
        {% include "partials/gameinfo.html.j2" %}

        <div class="mass-murderers-section">
            <h2>🏆 Massenmörder</h2>
            
            <div class="murderer-card general">
                <h3>Allgemein</h3>
                <div class="murderer-info">
                    {% if mass_murderers %}
                        <div class="murderer-names">{{ mass_murderers | map(attribute='name') | join(', ') }}</div>
                        <div class="murder-count">{{ completed_missions | selectattr('killer', 'eq', mass_murderers[0]) | list | length }} Morde</div>
                    {% else %}
                        <div class="no-murders">Noch keine Morde... vielleicht ist das hier doch nur ein Farming-Simulator?</div>
                    {% endif %}
                </div>
            </div>

            {% for circle_set in mass_murderers_circleset.keys() -%}
                <div class="murderer-card circle">
                    <h3>{{ circle_set }}</h3>
                    <div class="murderer-info">
                        {% if mass_murderers_circleset[circle_set] %}
                            <div class="murderer-names">{{ mass_murderers_circleset[circle_set] | map(attribute='name') | join(', ') }}</div>
                            {% set circle_murders = completed_missions_circleset[circle_set] | selectattr('killer', 'in', mass_murderers_circleset[circle_set]) | list %}
                            <div class="murder-count">{{ circle_murders | length }} Morde</div>
                        {% else %}
                            <div class="no-murders">Noch keine Morde in diesem Kreis... Peace was never an option! 🕊️</div>
                        {% endif %}
                    </div>
                </div>
            {%- endfor %}
        </div>
    </main>

    <footer class="grid footer-actions">
        {% if game.started %}
        <a role="button" class="primary" href="#record-murder">🗡️ Mord melden</a>
        {% else %}
        <a role="button" class="primary" href="#{{ add_player_form.form_id }}">👤 Spieler eintragen</a>
        {% endif %}

        <a role="button" class="secondary" href="../rules/{{ game.id }}">📜 Spielregeln</a>

        {% if game.started %}
        <a role="button" class="secondary" href="../game/{{ game.id }}/wall">🏆 Mörderwall</a>
        {% endif %}

        <a role="button" class="secondary" href="../game/{{ game.id }}/graph.svg" target="_blank">📊 Spielgraph</a>

        <a role="button" class="secondary" href="../gamemaster/{{ game.id }}">⚙️ Gamemaster</a>
    </footer>
</article>

{% if completed_missions_circleset %}
<h2>🗡️ Letzte Morde</h2>
<div id="missions">
    {% for circle_set in completed_missions_circleset.keys() %}
        {% if completed_missions_circleset[circle_set] %}
            <div class="mission-circle-section">
                <h3>{{ circle_set }}</h3>
                <div class="mission-cards-container">
                {% for mission in completed_missions_circleset[circle_set][:3] %}
                    {% include "partials/mission.html.j2" %}
                {% endfor %}
                </div>
                {% if completed_missions_circleset[circle_set] | length > 3 %}
                    <p style="text-align: center; margin-top: 1rem;">
                        <a href="../game/{{ game.id }}/wall">Alle {{ completed_missions_circleset[circle_set] | length }} Morde ansehen →</a>
                    </p>
                {% endif %}
            </div>
        {% endif %}
    {% endfor %}
</div>
{% endif %}
{% endblock %}

{% block modals %}
{% call dialog(title='Gamemaster-Login') %}
<main>
    {% with form = gamemaster_login_form %}
    <form method="post">
        {{ render_field(form.password, id=form.form_id) }}
        <button type="submit" name="form" value="{{ form.form_id }}">Anmelden</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% call dialog(title='Mord melden') %}
<main>
    {% with form = record_murder_form %}
    <form method="post">
        {{ render_field(form.killer, id='record-murder') }}
        {{ render_field(form.victim) }}
        {{ render_field(form.circle) }}
        {{ render_field(form.when, value=form.when.default) }}
        {{ render_field(form.mission_code) }}
        {{ render_field(form.description) }}

        <button type="submit" name="form" value="{{ form.form_id }}">Mord eintragen</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% call dialog(title='Spieler eintragen') %}
<main>
    {% with form = add_player_form %}
    <form method="post">
        {{ render_field(form.name, id=form.form_id) }}
        {{ render_field(form.password) }}
        {{ render_field(form.group) }}
        {{ render_field(form.email) }}
        {%  if game.circles %}
            {% for value, label in form.circle_sets.choices %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                    name="circle_sets" value="{{ value }}"
                    id="circle_sets_{{ loop.index }}"
                    {% if value in form.circle_sets.data %}
                           checked
                    {% endif %}>
                    <label class="form-check-label" for="circle_sets_{{ loop.index }}">
                    {{ label }}
                    </label>
                </div>
            {% endfor %}
        {% endif %}

        <button type="submit" name="form" value="{{ form.form_id }}">Spieler eintragen</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% call dialog(title='Login') %}
<main>
    {% with form = player_login_form %}
    <form method="post">
        {{ render_field(form.name, id=form.form_id) }}
        {{ render_field(form.password) }}
        <button type="submit" name="form" value="{{ form.form_id }}">Login</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% endblock %}