{% extends "_base.html.j2" %}

{% block main %}
<article id="game-details">
    <header>
        <h1>
            Spiel: {{ game.title }}
            <a role="button" class="primary" href="#{{ player_login_form.form_id }}" style="text-align: right;">Login</a>
        </h1>
    </header>
    <main>
        {% include "partials/gameinfo.html.j2" %}

        <div role="row">
            <h2>Massenmörder</h2>
            <h3>Allgemein</h3>
            <article>
                {{ mass_murderers | map(attribute='name') | join(', ') }}
                ({{ completed_missions | selectattr('killer', 'eq', mass_murderers[0]) | list | length }} Morde)
            </article>
            {% for circle_set in  mass_murderers_circleset.keys() -%}
                <article>
                    <h3>{{  circle_set }}</h3>
                    {%  if mass_murderers_circleset[circle_set] %}
                        {{ mass_murderers_circleset[circle_set] | map(attribute='name') | join(', ') }}
                        ({{ completed_missions_circleset[circle_set] | selectattr('killer', 'eq', mass_murderers_circleset[circle_set][0]) | list | length }} Morde)
                    {%  else %}
                        Noch keine Morde... vielleicht ist das hier doch nur ein Farming-Simulator?
                    {% endif %}
                 </article>

            {%- endfor %}

        </div>
    </main>

    <footer class="grid">
        {% if game.started %}
        <a role="button" class="primary" href="#record-murder">Mord melden</a>
        {% else %}
        <a role="button" class="primary" href="#{{ add_player_form.form_id }}">Spieler eintragen</a>
        {% endif %}

        <a role="button" class="secondary" href="../rules/{{ game.id }}">Spielregeln</a>

        {% if game.started %}
        <a role="button" class="secondary" href="../game/{{ game.id }}/wall">Mörderwall</a>
        {% endif %}

        <a role="button" class="secondary" href="../game/{{ game.id }}/graph.svg" target="_blank">Spielgraph</a>

        <a role="button" class="secondary" href="../gamemaster/{{ game.id }}">Gamemaster-Bereich</a>
    </footer>
</article>

<div id="missions">
    {% for circle_set in  completed_missions_circleset.keys() %}
        <h3> {{  circle_set }}</h3>
        <article>
        {% for mission in completed_missions_circleset[circle_set] -%}
            {% include "partials/mission.html.j2" %}
        {%- endfor %}
        </article>
    {% endfor %}
</div>
{% endblock %}

{% block modals %}
{% call dialog(title='Gamemaster-Login') %}
<main>
    {% with form = gamemaster_login_form %}
    <form method="post">
        {{ render_field(form.password, id=form.form_id) }}
        <button type="submit" name="form" value="{{ form.form_id }}">Anmelden</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% call dialog(title='Mord melden') %}
<main>
    {% with form = record_murder_form %}
    <form method="post">
        {{ render_field(form.killer, id='record-murder') }}
        {{ render_field(form.victim) }}
        {{ render_field(form.circle) }}
        {{ render_field(form.when, value=form.when.default) }}
        {{ render_field(form.mission_code) }}
        {{ render_field(form.description) }}

        <button type="submit" name="form" value="{{ form.form_id }}">Mord eintragen</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% call dialog(title='Spieler eintragen') %}
<main>
    {% with form = add_player_form %}
    <form method="post">
        {{ render_field(form.name, id=form.form_id) }}
        {{ render_field(form.password) }}
        {{ render_field(form.group) }}
        {{ render_field(form.email) }}
        {%  if game.circles %}
            {% for value, label in form.circle_sets.choices %}
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                    name="circle_sets" value="{{ value }}"
                    id="circle_sets_{{ loop.index }}"
                    {% if value in form.circle_sets.data %}
                           checked
                    {% endif %}>
                    <label class="form-check-label" for="circle_sets_{{ loop.index }}">
                    {{ label }}
                    </label>
                </div>
            {% endfor %}
        {% endif %}

        <button type="submit" name="form" value="{{ form.form_id }}">Spieler eintragen</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% call dialog(title='Login') %}
<main>
    {% with form = player_login_form %}
    <form method="post">
        {{ render_field(form.name, id=form.form_id) }}
        {{ render_field(form.password) }}
        <button type="submit" name="form" value="{{ form.form_id }}">Login</button>
    </form>
    {% endwith %}
</main>
{% endcall %}

{% endblock %}