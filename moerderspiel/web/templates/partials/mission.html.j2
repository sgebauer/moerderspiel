<article class="mission-card">
    <header class="players">
        <span class="killer">{{ mission.killer.name }}<br><small>{{ mission.killer.group }}</small></span>
        <span></span>
        <span class="victim">{{ mission.victim.name }}<br><small>{{ mission.victim.group }}</small></span>
    </header>
    <main>
        {{ mission.completion_reason }}
    </main>
    <footer>
        <small class="circle-marker">{{ mission.circle.name }}</small>
        <small data-tooltip="{{ mission.completion_date.strftime('%Y-%m-%d %H:%M:%S') }}">{{ mission.completion_date.strftime('%Y-%m-%d %H:%M') }}</small>
    </footer>
</article>
