<article class="mission-card">
    <header class="players">
        <span class="killer">{{ mission.killer.name if mission.killer else 'Gekickt' }}</span>
        <span class="vs-symbol">⚔</span>
        <span class="victim">{{ mission.victim.name }}</span>
    </header>
    <main>
        <p>{{ mission.completion_reason }}</p>
    </main>
    <footer>
        <span class="circle-marker">{{ mission.circle.name }}</span>
        <small>{{ mission.completion_date.strftime('%d.%m.%Y %H:%M') }}</small>
    </footer>
</article>
