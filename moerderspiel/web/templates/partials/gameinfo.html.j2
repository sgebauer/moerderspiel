<div class="game-info-grid">
    <div class="game-info-card">
        <div class="label">Spiel ID</div>
        <div class="value">🎯 {{ game.id }}</div>
    </div>
    <div class="game-info-card">
        <div class="label">Status</div>
        <div class="value status-{{ game.state.lower() }}">
            {% if game.state.lower() == 'active' %}🎮 {{ game.state }}
            {% elif game.state.lower() == 'waiting' %}⏳ {{ game.state }}
            {% elif game.state.lower() == 'finished' %}🏁 {{ game.state }}
            {% else %}{{ game.state }}
            {% endif %}
        </div>
    </div>
    <div class="game-info-card">
        <div class="label">Spieler</div>
        <div class="value">👥 {{ game.players | length }}</div>
    </div>
    <div class="game-info-card">
        <div class="label">Morde</div>
        <div class="value">💀 {{ completed_missions | length }}</div>
    </div>
</div>